###> Configuration pour PRODUCTION (VPS) ###
# Copier ce fichier vers .env.prod.local sur le serveur et ajuster les valeurs

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# IMPORTANT: Générer un nouveau secret avec: php bin/console secrets:generate-keys
APP_SECRET=VOTRE_SECRET_ICI_GENERER_UN_NOUVEAU
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Adapter avec vos informations de base de données MySQL/MariaDB sur le VPS
DATABASE_URL="mysql://UTILISATEUR_DB:MOT_DE_PASSE_DB@localhost:3306/NOM_DB?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# IMPORTANT: Utiliser la même passphrase que lors de la génération des clés JWT
JWT_PASSPHRASE=80ba90a1126b80df13e581225491bf33aca5c2c3aabdc928f11f412117cad695
###< lexik/jwt-authentication-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/routing ###
# URL de votre API en production (ex: https://api.votresite.com)
DEFAULT_URI=https://VOTRE_DOMAINE_API_ICI
###< symfony/routing ###

###> CORS Configuration ###
# URL de votre frontend Vue.js (ex: https://votresite.com)
CORS_ALLOW_ORIGIN=https://VOTRE_DOMAINE_FRONTEND_ICI
###< CORS Configuration ###
